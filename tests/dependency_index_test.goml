package tests;

use ecosystem::incremental as inc;
use std::testing;

#[test]
fn wide_dependency_reads_keep_first_order_and_revalidate_after_updates() -> () {
    let db = inc::Database::new();
    let inputs = Vec::new();
    let count = 2048;
    for index in 0..count {
        inputs.push(db.input("input_" + index.to_string(), index));
    }
    let query = testing::expect_ok(
        db.query(
            "total",
            1,
            |read: inc::Evaluation, _: isize| {
                let mut total = 0;
                for input in inputs {
                    total += read.input(input)?;
                }
                for index in 0..count {
                    total += read.input(inputs[count - index - 1])?;
                }
                Result::Ok(total)
            },
        ),
        "query",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "total"), count * (count - 1));
    let before = testing::expect_ok(db.inspect(query), "memo")[0];
    testing::assert_eq(before.dependencies.len(), count);
    for index in 0..count {
        testing::assert_eq(before.dependencies[index], "input_" + index.to_string());
    }
    testing::assert_ok(db.set(inputs[count - 1], count));
    testing::assert_eq(
        testing::expect_ok(db.fetch(query, 0), "changed last input"),
        count * (count - 1) + 2,
    );
    testing::assert_eq(testing::expect_ok(db.stats(query), "stats").executions, 2);
    let after = testing::expect_ok(db.inspect(query), "memo")[0];
    testing::assert(after.dependencies == before.dependencies);
    testing::assert(before.changed_at < after.changed_at);
}

#[test]
fn dependency_identity_is_independent_of_labels_and_evicted_memo_keys() -> () {
    let db = inc::Database::new();
    let left = db.input("same", 2);
    let right = db.input("same", 7);
    let leaf = testing::expect_ok(
        db.query_with(
            "value",
            1,
            |_: isize| "key",
            inc::ValuePolicy::immutable(),
            |read: inc::Evaluation, key: isize| read.input(
                if key == 0 {
                    left
                } else {
                    right
                },
            ),
        ),
        "leaf",
    );
    let query = testing::expect_ok(
        db.query(
            "total",
            1,
            |read: inc::Evaluation, _: isize| {
                let a = read.input(left)?;
                let b = read.query(leaf, 0)?;
                let again = read.query(leaf, 0)?;
                let c = read.input(right)?;
                let d = read.query(leaf, 1)?;
                let repeated = read.input(left)?;
                let evicted = read.query(leaf, 0)?;
                Result::Ok(a + b + again + c + d + repeated + evicted)
            },
        ),
        "parent",
    );
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "total"), 24);
    let dependencies = testing::expect_ok(db.inspect(query), "parent memo")[0].dependencies;
    testing::assert(
        dependencies == Vec::from_array(["same", "value(key)", "same", "value(key)", "value(key)"]),
    );
    testing::assert(
        testing::expect_ok(db.inspect(leaf), "leaf memo")[0].dependencies
            == Vec::from_array(["same"]),
    );
    testing::assert_eq(testing::expect_ok(db.stats(leaf), "leaf stats").executions, 3);
    testing::assert_ok(db.set(right, 9));
    testing::assert_eq(testing::expect_ok(db.fetch(query, 0), "updated"), 28);
    testing::assert_eq(testing::expect_ok(db.stats(query), "parent stats").executions, 2);
    testing::assert(
        testing::expect_ok(db.inspect(query), "parent memo")[0].dependencies == dependencies,
    );
}
