package tests;

use ecosystem::incremental as inc;
use std::panic;
use std::task;
use std::testing;

#[test]
fn query_panic_expires_saved_evaluation_and_releases_database() -> () {
    let database = inc::Database::new();
    let input = database.input("input", 1);
    let saved: Ref[Option[inc::Evaluation]] = Ref::new(Option::None);
    let original = testing::expect_err(panic::catch(|| panic::raise("query panic")), "original");
    let query: inc::Query[isize, isize] = testing::expect_ok(
        database.query(
            "panic",
            1,
            |read: inc::Evaluation, _: isize| {
                saved.set(Option::Some(read));
                panic::resume(original)
            },
        ),
        "query",
    );
    let caught = testing::expect_err(panic::catch(|| database.fetch(query, 0)), "panic");
    testing::assert_eq(caught.message(), original.message());
    testing::assert_eq(caught.stack_trace(), original.stack_trace());
    let read = testing::expect_some(saved.get(), "saved evaluation");
    testing::assert_eq(
        testing::expect_err(read.input(input), "expired after panic").kind,
        inc::ErrorKind::ExpiredEvaluation,
    );
    testing::assert_ok(database.try_set(input, 2));
}

#[test]
fn recursive_query_panic_unpins_memos_and_restores_capacity() -> () {
    let database = inc::Database::new();
    let installed: Ref[Option[inc::Query[isize, isize]]] = Ref::new(Option::None);
    let query: inc::Query[isize, isize] = testing::expect_ok(
        database.query(
            "recursive",
            1,
            |read: inc::Evaluation, key: isize| {
                if key == 0 {
                    panic::raise("leaf panic")
                }
                read.query(testing::expect_some(installed.get(), "installed query"), key - 1)
            },
        ),
        "query",
    );
    installed.set(Option::Some(query));
    let caught = testing::expect_err(panic::catch(|| database.fetch(query, 3)), "panic");
    testing::assert_eq(caught.message(), "leaf panic");
    testing::assert_eq(testing::expect_ok(database.inspect(query), "memo count").len(), 1);
    testing::assert_eq(testing::expect_ok(database.stats(query), "stats").evictions, 3);
}

#[test]
fn query_policy_panic_does_not_pin_old_memo_or_publish_partial_value() -> () {
    for stage in Vec::from_array(["copy", "equal"]) {
        let database = inc::Database::new();
        let input = database.input("input", 1);
        let armed = Ref::new(false);
        let query: inc::Query[isize, isize] = testing::expect_ok(
            database.query_with(
                "policy",
                1,
                |key: isize| key.to_string(),
                inc::ValuePolicy::new(
                    |left: isize, right| {
                        if armed.get() && stage == "equal" {
                            panic::raise("equal panic")
                        }
                        left == right
                    },
                    |value| {
                        if armed.get() && stage == "copy" {
                            panic::raise("copy panic")
                        }
                        value
                    },
                ),
                |read, key| Result::Ok(read.input(input)? + key),
            ),
            "query",
        );
        testing::assert_eq(testing::expect_ok(database.fetch(query, 0), "initial"), 1);
        let before = testing::expect_ok(database.inspect(query), "before")[0];
        testing::assert_ok(database.set(input, 2));
        armed.set(true);
        let caught = testing::expect_err(panic::catch(|| database.fetch(query, 0)), "panic");
        testing::assert_eq(caught.message(), stage + " panic");
        let after = testing::expect_ok(database.inspect(query), "after")[0];
        testing::assert_eq(after.verified_at, before.verified_at);
        testing::assert_eq(after.changed_at, before.changed_at);
        armed.set(false);
        testing::assert_eq(testing::expect_ok(database.fetch(query, 1), "new key"), 3);
        testing::assert_eq(testing::expect_ok(database.fetch(query, 1), "cached new key"), 3);
        testing::assert_eq(testing::expect_ok(database.stats(query), "stats").executions, 3);
    }
}

#[test]
fn batch_policy_panic_rolls_back_inputs_and_keeps_cached_queries_consistent() -> () {
    for stage in Vec::from_array(["copy", "equal"]) {
        let database = inc::Database::new();
        let left = database.input("left", 1);
        let unrelated = database.input("unrelated", false);
        let armed = Ref::new(false);
        let original = testing::expect_err(panic::catch(|| panic::raise("batch " + stage)), "panic");
        let right = database.input_with(
            "right",
            "old",
            inc::ValuePolicy::new(
                |left: string, right| {
                    if armed.get() && stage == "equal" {
                        panic::resume(original)
                    }
                    left == right
                },
                |value| {
                    if armed.get() && stage == "copy" {
                        panic::resume(original)
                    }
                    value
                },
            ),
        );
        let left_query = testing::expect_ok(
            database.query("left", 1, |read: inc::Evaluation, _: isize| read.input(left)),
            "left query",
        );
        let combined = testing::expect_ok(
            database.query(
                "combined",
                1,
                |read: inc::Evaluation, _: isize| Result::Ok(
                    read.query(left_query, 0)?.to_string() + ":" + read.input(right)?,
                ),
            ),
            "combined query",
        );
        testing::assert_eq(testing::expect_ok(database.fetch(combined, 0), "initial"), "1:old");
        let revision = database.revision();
        let changes = Vec::from_array([left.change(2), left.change(3), right.change("new")]);
        armed.set(true);
        let caught = testing::expect_err(panic::catch(|| database.apply(changes)), "batch panic");
        testing::assert_eq(caught.message(), original.message());
        testing::assert_eq(caught.stack_trace(), original.stack_trace());
        armed.set(false);
        testing::assert_eq(database.revision(), revision);
        testing::assert_eq(
            testing::expect_ok(database.evaluate(|read| read.input(left)), "rolled back left"),
            1,
        );
        testing::assert_eq(
            testing::expect_ok(database.evaluate(|read| read.input(right)), "unchanged right"),
            "old",
        );
        testing::assert_eq(testing::expect_ok(database.fetch(combined, 0), "cached"), "1:old");
        testing::assert_ok(database.try_set(unrelated, true));
        testing::assert_eq(testing::expect_ok(database.fetch(combined, 0), "validated"), "1:old");
        testing::assert_eq(
            testing::expect_ok(database.stats(left_query), "left stats").executions,
            1,
        );
        testing::assert_eq(
            testing::expect_ok(database.stats(combined), "combined stats").executions,
            1,
        );
        testing::assert(testing::expect_ok(database.apply(changes), "retry prepared changes"));
        testing::assert_eq(database.revision(), revision + 2);
        testing::assert_eq(testing::expect_ok(database.fetch(combined, 0), "updated"), "3:new");
    }
}

#[test]
fn concurrent_readers_never_observe_a_panicking_batch_partial_updates() -> () {
    let database = inc::Database::new();
    let left = database.input("left", 0);
    let right = database.input_with(
        "right",
        "stable",
        inc::ValuePolicy::new(|_: string, _: string| panic::raise("rejected update"), |value| value),
    );
    let changes = Vec::from_array([left.change(1), right.change("unreachable")]);
    task::scope(
        |scope| {
            let writer = scope.spawn(
                |_| {
                    for _ in 0..50 {
                        let caught = testing::expect_err(
                            panic::catch(|| database.apply(changes)),
                            "batch panic",
                        );
                        testing::assert_eq(caught.message(), "rejected update");
                    }
                },
            );
            for _ in 0..100 {
                let pair = testing::expect_ok(
                    database.evaluate(|read| Result::Ok((read.input(left)?, read.input(right)?))),
                    "coherent snapshot",
                );
                testing::assert(pair == (0, "stable"));
            }
            writer.join();
        },
    );
    testing::assert_eq(database.revision(), 1);
    testing::assert_eq(
        testing::expect_ok(database.evaluate(|read| read.input(left)), "after writer"),
        0,
    );
}
